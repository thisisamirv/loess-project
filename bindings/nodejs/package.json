{
    "name": "fastloess",
    "version": "2.0.0",
    "description": "High-performance LOESS smoothing for Node.js",
    "main": "index.js",
    "types": "index.d.ts",
    "scripts": {
        "build": "napi build --release --platform",
        "build:debug": "napi build --platform",
        "test": "node --test tests/test_fastloess.js",
        "lint": "oxlint index.js tests/test_fastloess.js",
        "universal": "napi universal",
        "snippets": "python3 ../../dev/verify_snippets.py --lang nodejs --timeout 120 --update-outputs",
        "readme": "python3 ../../dev/add-readme-to-docs.py",
        "docs": "npm run snippets && npm run readme && typedoc && node ../../dev/lowercase-typedoc-refs.js src/content/docs/reference && astro build",
        "docs:preview": "astro preview"
    },
    "napi": {
        "binaryName": "fastloess",
        "targets": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "aarch64-unknown-linux-musl",
            "armv7-unknown-linux-gnueabihf",
            "x86_64-unknown-linux-musl",
            "x86_64-pc-windows-msvc",
            "aarch64-pc-windows-msvc",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
        ]
    },
    "optionalDependencies": {
        "fastloess-darwin-arm64": "^2.0.0",
        "fastloess-darwin-x64": "^2.0.0",
        "fastloess-linux-arm64-gnu": "^2.0.0",
        "fastloess-linux-arm64-musl": "^2.0.0",
        "fastloess-linux-arm-gnueabihf": "^2.0.0",
        "fastloess-linux-x64-gnu": "^2.0.0",
        "fastloess-linux-x64-musl": "^2.0.0",
        "fastloess-win32-arm64-msvc": "^2.0.0",
        "fastloess-win32-x64-msvc": "^2.0.0"
    },
    "devDependencies": {
        "@astrojs/markdown-remark": "^7.3",
        "@astrojs/starlight": "^0.42",
        "@napi-rs/cli": "^3.9",
        "astro": "^7.3",
        "katex": "^0.18",
        "oxlint": "^1.81",
        "rehype-katex": "^7.0",
        "remark-math": "^6.0",
        "typedoc": "^0.28",
        "typedoc-plugin-markdown": "^4.13"
    },
    "engines": {
        "node": ">= 20"
    },
    "license": "MIT OR Apache-2.0"
}