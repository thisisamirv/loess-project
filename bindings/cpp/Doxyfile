# ---------------------------------------------------------------------------

# Project

# ---------------------------------------------------------------------------

PROJECT_NAME           = "fastloess-cpp"
PROJECT_BRIEF          = "High-performance LOESS smoothing — C++ API"
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO
TOC_INCLUDE_HEADINGS   = 0

# ---------------------------------------------------------------------------

# Input

# ---------------------------------------------------------------------------

INPUT                  = README.md include docs
FILE_PATTERNS          = *.hpp *.h *.md
IMAGE_PATH             = assets/diagrams
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md

# ---------------------------------------------------------------------------

# Extraction

# ---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES

# ---------------------------------------------------------------------------

# HTML output

# ---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
# renovate: doxygen-awesome-css version: v2.4.2 (https://github.com/jothepro/doxygen-awesome-css)
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome-css/doxygen-awesome.css \
                         docs/doxygen-awesome-css/doxygen-awesome-sidebar-only.css

# ---------------------------------------------------------------------------

# Disable non-HTML formats

# ---------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# ---------------------------------------------------------------------------

# Warnings

# ---------------------------------------------------------------------------

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_DOC_ERROR      = NO
HAVE_DOT               = NO
USE_MATHJAX            = YES
