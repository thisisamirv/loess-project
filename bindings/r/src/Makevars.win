TARGET_DIR = ./target

# R-Universe sets CARGO_BUILD_TARGET for cross-compilation (e.g. aarch64-pc-windows-gnullvm)
RUST_TARGET := $(if $(CARGO_BUILD_TARGET),$(CARGO_BUILD_TARGET),x86_64-pc-windows-gnu)
LIBDIR = $(TARGET_DIR)/$(RUST_TARGET)/release
STATLIB = $(LIBDIR)/librfastloess.a

# gnullvm: skip --whole-archive to avoid lld duplicate-symbol crashes from
# per-crate raw-dylib stubs; entrypoint.c refs the extendr init symbol directly.
ifneq ($(findstring gnullvm,$(RUST_TARGET)),)
WHOLE_ARCHIVE_LIBS = -lrfastloess
else
WHOLE_ARCHIVE_LIBS = -Wl,--whole-archive -lrfastloess -Wl,--no-whole-archive
endif
PKG_LIBS = -L$(LIBDIR) $(WHOLE_ARCHIVE_LIBS) -lws2_32 -luserenv -ladvapi32 -lbcrypt -lncrypt -lntdll -Wl,--export-all-symbols

all: clean $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	@cargo --version
	@rustc --version
	@# Extract vendored dependencies if archive exists and vendor dir doesn't
	@if [ -f vendor.tar.xz ] && [ ! -d vendor ]; then \
		echo "Extending vendor.tar.xz..."; \
		$(TAR) -xf vendor.tar.xz; \
	fi
	@# Create .cargo/config.toml from non-hidden source (avoids R CMD check NOTE)
	@mkdir -p .cargo
	@cp cargo-config.toml .cargo/config.toml
	@mkdir -p $(TARGET_DIR)
	@# Rtools45 posix-static toolchain omits libgcc_eh.a; create a dummy so build scripts link
	@if [ "$(RUST_TARGET)" = "x86_64-pc-windows-gnu" ]; then \
		_gcc_lib=$$(x86_64-w64-mingw32.static.posix-gcc -print-file-name=libgcc.a); \
		_gcc_libdir=$$(dirname "$$_gcc_lib"); \
		test -f "$$_gcc_libdir/libgcc_eh.a" || x86_64-w64-mingw32.static.posix-ar rcs "$$_gcc_libdir/libgcc_eh.a"; \
	fi
	@cargo build -q -j 2 --release --manifest-path=Cargo.toml --target-dir $(TARGET_DIR) --target $(RUST_TARGET)
	@# ar x without a member name resolves long-name entries (>16 chars stored as /<offset>)
	@if echo "$(RUST_TARGET)" | grep -q gnullvm; then \
		_lib=$$(pwd)/$(STATLIB); \
		mkdir -p _ar_patch; \
		(cd _ar_patch || exit 0; \
			ar x "$$_lib" 2>/dev/null; \
			for _dll in *.dll; do \
				[ -f "$$_dll" ] && { \
					objcopy --remove-section='.idata$$4' "$$_dll" 2>/dev/null || true; \
					ar r "$$_lib" "$$_dll" 2>/dev/null; \
				}; \
			done); \
		rm -rf _ar_patch; \
	fi
	@rm -rf .cargo

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)
